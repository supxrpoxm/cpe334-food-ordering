# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/food_ordering?schema=public"

# HTTP port the API server listens on (Cloud Run sets this automatically).
PORT=3001

# Secret key used to sign and verify JWT authentication cookies (required).
JWT_SECRET="change-me-to-a-long-random-secret"

# Allowed frontend origin for CORS. Defaults to http://localhost:3000 if unset.
# CORS_ORIGIN="http://localhost:3000"

# Runtime mode. Cloud Run uses "production".
# NODE_ENV=development

# Passwords for seeded accounts (required when running prisma db seed; never put real passwords here).
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# Enable seeding the demo customer account ("true" or "false").
SEED_DEMO_DATA=true