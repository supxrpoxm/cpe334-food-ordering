# Copy this file to ".env" and fill in your own local values.
# Do NOT commit your real .env file.
# Use port 5433 when connecting to the database published by docker-compose.yml.
DATABASE_URL="postgresql://food_ordering:food_ordering@localhost:5432/food_ordering?schema=public"
DEMO_USER_PASSWORD="replace-with-a-local-demo-password"
DEMO_USER_B_PASSWORD="replace-with-a-different-local-demo-password"
PORT=3000
